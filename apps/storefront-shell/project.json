{
  "name": "storefront-shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/storefront-shell/src",
  "projectType": "application",
  "tags": ["type:shell"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "rspack serve --mode=development",
        "cwd": "apps/storefront-shell"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rspack build --mode=production",
        "cwd": "apps/storefront-shell"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/storefront-shell"],
      "options": {
        "jestConfig": "apps/storefront-shell/jest.config.cts"
      }
    }
  }
}
