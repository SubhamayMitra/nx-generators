{
  "name": "storefront-mfe-checkout",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/storefront-mfe-checkout/src",
  "projectType": "application",
  "tags": ["type:mfe"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "rspack serve --mode=development",
        "cwd": "apps/storefront-mfe-checkout"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rspack build --mode=production",
        "cwd": "apps/storefront-mfe-checkout"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/storefront-mfe-checkout"],
      "options": {
        "jestConfig": "apps/storefront-mfe-checkout/jest.config.cts"
      }
    }
  },
  "metadata": {
    "mfeState": "zustand"
  }
}
